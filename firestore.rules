rules_version = '2';

// invest-tracker-f7e3f Firestore 보안 규칙
//
// 지키려는 것은 비밀이 아니라 3년치 기록 그 자체다.
// 여기 담긴 값은 코스피·환율·금 시세처럼 어차피 공개된 시장 데이터이고,
// 2026-03까지는 저장소의 initial_data.js에도 그대로 들어 있다.
// 그래서 읽기는 종전대로 열어두고, 지우거나 바꾸는 쪽만 막는다.
//
// 읽기를 열어두면 새 기기에서 로그인 없이도 기록을 볼 수 있고,
// 오프라인 PWA 동작도 지금 그대로 유지된다.
//
// 쓰기 권한은 allowedUsers/{uid} 문서가 있는 계정만 갖는다.
// 허용 계정을 규칙이 아니라 DB에 두는 이유: 이 저장소는 공개라서
// uid를 소스에 적어둘 수 없고, 사람을 더하고 뺄 때 규칙을 다시
// 배포하지 않아도 된다.
//
// GitHub Actions의 자동 입력은 서비스 계정으로 붙으므로 이 규칙을 거치지 않는다.

service cloud.firestore {
  match /databases/{database}/documents {

    match /allowedUsers/{uid} {
      // 자기 권한만 확인할 수 있다. 남의 uid나 전체 목록은 못 읽는다.
      allow read: if request.auth != null && request.auth.uid == uid;
      // 권한 부여는 콘솔이나 서비스 계정으로만. 앱에서는 못 바꾼다.
      allow write: if false;
    }

    match /sync/{key} {
      allow read: if true;
      allow write: if request.auth != null
                   && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.uid));
    }

    // 위에 적지 않은 경로는 전부 거부된다.
  }
}
