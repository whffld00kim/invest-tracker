rules_version = '2';

// invest-tracker-f7e3f Firestore 보안 규칙
//
// 지키려는 것은 비밀이 아니라 3년치 기록 그 자체다.
// 여기 담긴 값은 코스피·환율·금 시세처럼 어차피 공개된 시장 데이터이고,
// 2026-03까지는 저장소의 initial_data.js에도 그대로 들어 있다.
// 그래서 읽기는 종전대로 열어두고, 지우거나 바꾸는 쪽만 막는다.
//
// 읽기를 열어두면 새 기기에서 로그인 없이도 기록을 볼 수 있고,
// 오프라인 PWA 동작도 지금 그대로 유지된다.
//
// ⚠ 2026-09-03부터 앱(클라이언트)의 쓰기는 **전부 거부**한다.
// 앱이 올릴 때는 기기 데이터로 문서를 통째로 덮어쓰는 방식이라, 오래 안 켠 기기에서
// 올리면 그 사이 자동 수집된 날들이 전부 사라진다. 그래서 앱을 받기 전용으로 바꾸고
// 서버에서도 막는다 — 옛 캐시 버전 앱이 남아 있어도 못 올린다.
// 기록은 GitHub Actions(collect.js)의 서비스 계정만 쓰고, 서비스 계정은 이 규칙을 거치지 않는다.
// 값을 고쳐야 하면 Actions의 --only 실행이나 서비스 계정(Claude)으로 그 날짜만 고친다.
//
// allowedUsers/ 컬렉션은 더 이상 쓰기 판정에 쓰이지 않지만, 되돌릴 때를 위해 남겨 둔다.

service cloud.firestore {
  match /databases/{database}/documents {

    match /allowedUsers/{uid} {
      // 자기 권한만 확인할 수 있다. 남의 uid나 전체 목록은 못 읽는다.
      allow read: if request.auth != null && request.auth.uid == uid;
      // 권한 부여는 콘솔이나 서비스 계정으로만. 앱에서는 못 바꾼다.
      allow write: if false;
    }

    match /sync/{key} {
      allow read: if true;
      // 앱에서는 못 쓴다 (2026-09-03). 서비스 계정(Actions·Claude)만 쓴다.
      allow write: if false;
    }

    // 위에 적지 않은 경로는 전부 거부된다.
  }
}
